<resources>
    <!-- the app's first screen (ui/Smer.kt OdvaznaPalette.bg, ui/Theme.kt Tmavy.bg): splash and window hand over with
         no change of colour -->
    <color name="board">#181D1B</color>
    <color name="paper">#F3EEE3</color>
    <!-- the launcher icon's flat green (ic_launcher_background) -->
    <color name="icon_bg">#2B6656</color>
    <color name="splash_bg">@color/paper</color>
    <style name="Theme.Tabula" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- the launcher icon itself: F² on its flat green disc, on the page of the first screen (Teo, 18. 11.: the old splash
         drew the old vector mark) -->
    <style name="Theme.Tabula.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Tabula</item>
    </style>
</resources>
