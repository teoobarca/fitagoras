<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup is off; device-to-device transfer (Android 12+) must not carry the tutor's photos either. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="tutor-zbierka/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="tutor-zbierka/"/>
    </device-transfer>
</data-extraction-rules>
